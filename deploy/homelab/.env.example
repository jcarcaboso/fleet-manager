# Homelab Docker Compose settings.
# First generate credentials and .env with:
#   FLEET_HOSTNAME=fleet.home.arpa python3 setup.py --bind-ip 0.0.0.0
# Then edit the generated .env using this file as a reference.
# Do not copy this file to .env before setup.py; setup refuses existing files.

# Server image tag or immutable image digest. This release supports linux/amd64.
FLEET_IMAGE=skorcius/fleet-manager:0.5.0

# Hostname or IP clients use, without a scheme or port.
# Setup reads this from the shell environment to generate the TLS certificate.
# Compose also uses it for dashboard/enrollment URLs unless FLEET_PUBLIC_URL is set.
# It does not change DNS or regenerate certificates.
FLEET_HOSTNAME=fleet.home.arpa

# Host interface for the published port.
# 127.0.0.1 = local access; 0.0.0.0 = all IPv4 interfaces.
# You can also use your homelab's private interface IP.
FLEET_BIND_IP=127.0.0.1

# Published HTTPS port. The container always listens on 7443.
# If changed after setup, update FLEET_SERVER_URL in operator.env too.
FLEET_PORT=7443

# Optional explicit HTTPS origin for dashboard access and enrollment links.
# Defaults to https://${FLEET_HOSTNAME}:${FLEET_PORT} in Compose.
# No path, query, or credentials. Use brackets for IPv6 addresses.
# The hostname must already be covered by the server's TLS certificate.
# FLEET_PUBLIC_URL=https://fleet.home.arpa:7443

# Optional Git source. Leave empty until the repository is ready.
# Examples: https://github.com/your-org/skills.git
#           ssh://git@github.com/your-org/skills.git
# Private SSH sources require a deploy key and known_hosts in ssh/.
# Do not embed credentials in the URL.
FLEET_SOURCE_REMOTE=

# CLI settings are generated separately in operator.env:
#   FLEET_SERVER_URL=https://fleet.home.arpa:7443
#   FLEET_OPERATOR_TOKEN=<generated bearer token>
# Database credentials and server settings live in secrets/, not this file.
