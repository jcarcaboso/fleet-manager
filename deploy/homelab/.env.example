# Homelab Docker Compose settings.
# First generate credentials and .env with:
#   FLEET_HOSTNAME=fleet.home.arpa python3 setup.py --bind-ip 0.0.0.0
# Then edit the generated .env using this file as a reference.
# Do not copy this file to .env before setup.py; setup refuses existing files.

# Server image tag or immutable image digest. This release supports linux/amd64.
FLEET_IMAGE=skorcius/fleet-manager:0.12.0

# Dashboard image tag or immutable image digest (linux/amd64). It is a separate
# image from the Server and must come from the same release as FLEET_IMAGE.
# Defaults in compose.yaml to the dashboard version of this release.
FLEET_DASHBOARD_IMAGE=skorcius/fleet-manager:dashboard-0.12.0

# Hostname or IPv4 address clients use, without a scheme or port.
# Setup reads this from the shell environment to generate the TLS certificate.
# Compose also uses it for the Server and dashboard URLs unless FLEET_PUBLIC_URL or
# FLEET_DASHBOARD_URL is set.
# It does not change DNS or regenerate certificates.
FLEET_HOSTNAME=fleet.home.arpa

# Host interface for the published port.
# 127.0.0.1 = local access; 0.0.0.0 = all IPv4 interfaces.
# You can also use your homelab's private interface IP.
FLEET_BIND_IP=127.0.0.1

# Published HTTPS port. The container always listens on 7443.
# If changed after setup, update FLEET_SERVER_URL in operator.env too.
FLEET_PORT=7443

# Published HTTPS port of the dashboard container (it always listens on 8443).
# Must differ from FLEET_PORT. Open it to the same clients as FLEET_PORT.
FLEET_DASHBOARD_PORT=7444

# Optional explicit HTTPS origin of the Server, used for enrollment links and by the
# dashboard to find the Server.
# Defaults to https://${FLEET_HOSTNAME}:${FLEET_PORT} in Compose.
# No path, query, or credentials. Use a DNS hostname or an IPv4 address, not an
# IPv6 literal: the dashboard's Content-Security-Policy cannot name one, so the
# dashboard refuses to start with it. Give an IPv6 address a DNS name instead.
# The hostname must already be covered by the server's TLS certificate.
# FLEET_PUBLIC_URL=https://fleet.home.arpa:7443

# Optional explicit HTTPS origin of the dashboard, as the browser opens it.
# Defaults to https://${FLEET_HOSTNAME}:${FLEET_DASHBOARD_PORT} in Compose.
# The Server allows exactly this origin to call its dashboard API (CORS) and
# redirects /dashboard here. Same rules as FLEET_PUBLIC_URL: https, no path, query, or
# credentials, a hostname or IPv4 address (no IPv6 literal).
# The dashboard serves secrets/tls/dashboard.pem, which carries the same names as the
# Server certificate. Installations created before it existed run
# "python3 setup.py --add-dashboard" once; that also adds the three FLEET_DASHBOARD_*
# settings here if they are missing.
# Same-site rule: the dashboard and the Server must be on the same site, that is the
# same host name or registrable domain (ports and subdomains may differ), both over
# HTTPS. Otherwise the browser does not send the SameSite=Strict session cookie and
# sign-in fails. Setup uses the same host for both.
# FLEET_DASHBOARD_URL=https://fleet.home.arpa:7444

# Optional Git source. Leave empty until the repository is ready.
# Examples: https://github.com/your-org/skills.git
#           ssh://git@github.com/your-org/skills.git
# Private SSH sources require a deploy key and known_hosts in ssh/.
# Do not embed credentials in the URL.
FLEET_SOURCE_REMOTE=

# Optional CLIProxyAPI bearer key. Compose maps it to Fleet__CliProxyApiKey.
# Prefer injecting it into the Compose environment from a secret manager.
# If you keep it in .env, protect that file and keep it out of source control.
# FLEET_CLIPROXY_API_KEY=replace-with-a-dedicated-proxy-key

# CLI settings are generated separately in operator.env:
#   FLEET_SERVER_URL=https://fleet.home.arpa:7443
#   FLEET_OPERATOR_TOKEN=<generated bearer token>
# Database credentials and server settings live in secrets/, not this file.
